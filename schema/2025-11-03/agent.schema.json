{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multi-agent-fairness-eval/schema/2025-11-03/agent.schema.json",
  "title": "Agent Configuration",
  "description": "Configuration for a single agent in the multi-agent conversation",
  "type": "object",
  "required": ["agent_id", "role", "as_human", "model", "temperature", "max_tokens"],
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Unique identifier for the agent (e.g., 'speaker_001', 'speaker_002')",
      "pattern": "^speaker_\\d{3}$"
    },
    "role": {
      "type": "string",
      "description": "Agent's role in the conversation (determines routing behavior)",
      "examples": ["participant", "devils_advocate", "judge", "mediator"]
    },
    "persona": {
      "type": ["string", "null"],
      "description": "Domain expertise or professional identity (null if not specified)",
      "examples": ["doctor", "economist", "policy_expert", "teacher", null]
    },
    "demographics": {
      "type": ["string", "null"],
      "description": "Social category/categories (null if not specified)",
      "examples": ["black", "white", "white female", "asian male", null]
    },
    "as_human": {
      "type": "boolean",
      "description": "Presentation style: true = human actor, false = AI assistant"
    },
    "model": {
      "type": "string",
      "description": "Model identifier ('shared' to use shared_model_backbone, or specific model name)"
    },
    "temperature": {
      "type": "number",
      "description": "Sampling temperature for response generation",
      "minimum": 0.0,
      "maximum": 2.0
    },
    "max_tokens": {
      "type": "integer",
      "description": "Maximum tokens to generate in responses",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
