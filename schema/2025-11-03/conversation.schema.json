{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multi-agent-fairness-eval/schema/2025-11-03/conversation.schema.json",
  "title": "Multi-Agent Conversation Transcript",
  "description": "Complete transcript of a multi-agent conversation for fairness evaluation",
  "type": "object",
  "required": [
    "transcript_id",
    "protocol_version",
    "experiment_metadata",
    "question",
    "routing_config",
    "agents",
    "conversation_rounds",
    "created_at"
  ],
  "properties": {
    "transcript_id": {
      "type": "string",
      "description": "UUID for this transcript (matches filename)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "protocol_version": {
      "type": "string",
      "description": "Schema version date (e.g., '2025-11-03')",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "experiment_metadata": {
      "type": "object",
      "description": "High-level experiment information",
      "required": [
        "experiment_name",
        "benchmark_name",
        "config_snapshot_path",
        "submission_timestamp",
        "execution_timestamp"
      ],
      "properties": {
        "experiment_name": {
          "type": "string",
          "description": "Experiment identifier following naming convention"
        },
        "benchmark_name": {
          "type": "string",
          "description": "Benchmark dataset name"
        },
        "config_snapshot_path": {
          "type": "string",
          "description": "Path to the config snapshot used for this run"
        },
        "submission_timestamp": {
          "type": "string",
          "description": "When the job was submitted/started",
          "format": "date-time"
        },
        "execution_timestamp": {
          "type": "string",
          "description": "When the conversation executed",
          "format": "date-time"
        },
        "agent_config_axes": {
          "type": "array",
          "description": "List of varied agent attributes",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "question": {
      "$ref": "question.schema.json",
      "description": "The question being discussed"
    },
    "routing_config": {
      "$ref": "routing.schema.json",
      "description": "Routing strategy configuration"
    },
    "agents": {
      "type": "array",
      "description": "All agents participating in the conversation",
      "items": {
        "$ref": "agent.schema.json"
      },
      "minItems": 1
    },
    "conversation_rounds": {
      "type": "array",
      "description": "All rounds of the conversation",
      "items": {
        "type": "object",
        "required": ["round_number", "messages"],
        "properties": {
          "round_number": {
            "type": "integer",
            "description": "Round number (0-indexed)",
            "minimum": 0
          },
          "messages": {
            "type": "array",
            "description": "Messages in this round",
            "items": {
              "$ref": "message.schema.json"
            }
          },
          "round_metadata": {
            "type": "object",
            "description": "Optional metadata about this round",
            "properties": {
              "round_start_time": {
                "type": "string",
                "format": "date-time"
              },
              "round_end_time": {
                "type": "string",
                "format": "date-time"
              },
              "consensus_score": {
                "type": ["number", "null"],
                "description": "Consensus score at end of round (0.0 to 1.0)",
                "minimum": 0.0,
                "maximum": 1.0
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "final_outputs": {
      "type": "object",
      "description": "Final outputs from the conversation",
      "properties": {
        "consensus_reached": {
          "type": "boolean",
          "description": "Whether consensus was reached"
        },
        "final_answer": {
          "type": ["string", "null"],
          "description": "Final answer if consensus reached"
        },
        "agent_final_positions": {
          "type": "object",
          "description": "Final position of each agent",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "conversation_metadata": {
      "type": "object",
      "description": "Metadata about the entire conversation",
      "properties": {
        "total_messages": {
          "type": "integer",
          "description": "Total number of messages",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "description": "Total tokens generated",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "description": "Total conversation duration",
          "minimum": 0
        },
        "rounds_completed": {
          "type": "integer",
          "description": "Number of rounds completed",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "description": "Timestamp when transcript was created",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
